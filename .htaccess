# Upprime Connect, Zugriffsschutz fuer interne Dateien
#
# Hintergrund: die Auslieferung spiegelt das gesamte Repository ins public_html.
# Dadurch waren Arbeitsdateien wie CLAUDE.md, package.json oder die Social Media
# Vorlagen oeffentlich abrufbar. Diese Datei sperrt sie wieder.
#
# Die Website selbst braucht nur index.html, impressum.html, datenschutz.html,
# die AGB als PDF, sieben Bilder, die drei Symboldateien und den Ordner
# fonts. Alles andere darf zu.

# Verzeichnislisten aus, falls sie je eingeschaltet werden
Options -Indexes

# Nur eine Adresse fuer Google und KI Suchmaschinen: www leitet dauerhaft
# auf die Domain ohne www weiter, Pfad und Parameter bleiben erhalten.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.upprime-connect\.at$ [NC]
RewriteRule ^(.*)$ https://upprime-connect.at/$1 [R=301,L]

# KI Agenten, die ausdruecklich Markdown anfragen (Accept: text/markdown),
# bekommen auf der Startseite die llms.txt. Browser fragen nie danach.
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteRule ^(index\.html)?$ /llms.txt [T=text/markdown,L]
AddCharset utf-8 .txt

# Die Startseite verweist im HTTP Kopf auf die Kurzbeschreibung fuer KI
# (llms.txt) und auf die Sitemap, damit Agenten sie ohne Suchen finden.
<IfModule mod_headers.c>
    <Files "index.html">
        Header set Link "</llms.txt>; rel=alternate, </llms.txt>; rel=describedby, </sitemap.xml>; rel=sitemap"
        Header merge Vary "Accept"
    </Files>
    <Files "llms.txt">
        Header merge Vary "Accept"
    </Files>
</IfModule>

# Die Geburtstagsaktion ist beendet, die Teilnahmebedingungen sind entfernt.
# Alte Links sollen nicht ins Leere laufen, sie landen auf der Startseite.
Redirect 301 /teilnahmebedingungen.html /

# Diese Datei selbst
<Files ".htaccess">
    Require all denied
</Files>

# Dateiendungen, die nie oeffentlich gehoeren
<FilesMatch "\.(md|json|yml|yaml|lock|sh|log|bak|sql|env|config)$">
    Require all denied
</FilesMatch>

# Punktdateien, etwa .gitignore
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Interne Werkzeuge
<FilesMatch "^(server|screenshot.*)\.js$">
    Require all denied
</FilesMatch>

# Vorlagen fuer Social Media, kein Teil der Website
<FilesMatch "^(instagram-.*|facebook-header)\.(html|png|jpg|jpeg|webp)$">
    Require all denied
</FilesMatch>

# Ordner, die nur zur Entwicklung gehoeren
RedirectMatch 404 ^/(\.github|\.git|\.claude|\.agents|node_modules)(/|$)
